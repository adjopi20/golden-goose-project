# Separate from .env used by the running alerts container. Never commit keys.
BINANCE_ENV=testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_KEY_TYPE=hmac
# Ed25519: no API secret. See BINANCE_ED25519.md; mount the PEM, never copy it here.
BINANCE_PRIVATE_KEY_HOST_PATH=
BINANCE_PRIVATE_KEY_PASSPHRASE_HOST_PATH=
# Disabled until the authenticated read-only Testnet check passes.
BINANCE_TESTNET_EXECUTION_ENABLED=false
INITIAL_CAPITAL=1000
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
