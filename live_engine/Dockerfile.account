FROM python:3.13-slim-bookworm
ARG CODE_VERSION
RUN test -n "$CODE_VERSION"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GG_CODE_VERSION=$CODE_VERSION
LABEL org.opencontainers.image.revision=$CODE_VERSION
WORKDIR /app
RUN pip install --no-cache-dir nats-py==2.15.0 \
    && useradd --system --uid 10001 --create-home account \
    && mkdir /data && chown account:account /data
COPY trading_core/__init__.py trading_core/contracts.py trading_core/paper_execution.py /app/trading_core/
COPY live_engine/__init__.py live_engine/state_store.py live_engine/order_manager.py live_engine/account_store.py live_engine/account_owner.py live_engine/account_worker.py live_engine/service_health.py /app/live_engine/
COPY market_data/__init__.py market_data/broker.py market_data/shadow.py /app/market_data/
COPY models/trend_following_preny_profile_15m/deploy/phase4/*.json /app/config/
USER account
ENTRYPOINT ["python", "-m", "live_engine.account_worker"]
