FROM python:3.13-slim-bookworm
ARG CODE_VERSION
RUN test -n "$CODE_VERSION"
LABEL org.opencontainers.image.revision=$CODE_VERSION
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir requests==2.33.1 cryptography==50.0.2 \
    && useradd --system --uid 10001 --create-home preflight
COPY live_engine/__init__.py live_engine/futures_preflight.py /app/live_engine/
COPY live_engine/adapters/__init__.py live_engine/adapters/binance_futures_readonly.py /app/live_engine/adapters/
COPY models/trend_following_preny_profile_15m/deploy/pilot.ethusdc.preflight.json /app/config/pilot.json
USER preflight
ENTRYPOINT ["python", "-m", "live_engine.futures_preflight"]
