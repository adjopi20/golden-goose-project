FROM python:3.13-slim-bookworm
ARG CODE_VERSION
RUN test -n "$CODE_VERSION"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 GG_CODE_VERSION=$CODE_VERSION
LABEL org.opencontainers.image.revision=$CODE_VERSION
WORKDIR /app
RUN pip install --no-cache-dir nats-py==2.15.0 \
    && useradd --system --uid 10001 --create-home account \
    && mkdir /data && chown account:account /data
COPY utils/__init__.py /app/utils/__init__.py
COPY paper_trading/__init__.py /app/paper_trading/
COPY utils/engine/adapters/paper_execution.py /app/utils/engine/adapters/paper_execution.py
COPY utils/engine/contracts.py /app/utils/engine/contracts.py
COPY utils/engine/__init__.py /app/utils/engine/__init__.py
COPY utils/engine/state/base.py /app/utils/engine/state/base.py
COPY utils/engine/execution/paper_manager.py /app/utils/engine/execution/paper_manager.py
COPY utils/engine/state/paper_account.py /app/utils/engine/state/paper_account.py
COPY utils/engine/execution/paper_account.py /app/utils/engine/execution/paper_account.py
COPY utils/engine/execution/paper_worker.py /app/utils/engine/execution/paper_worker.py
COPY utils/engine/monitoring/service_health.py /app/utils/engine/monitoring/service_health.py
COPY utils/engine/operations/account_delivery_upgrade.py /app/utils/engine/operations/account_delivery_upgrade.py
COPY utils/engine/operations/upgrade_phase4_account_health.py /app/utils/engine/operations/upgrade_phase4_account_health.py
COPY utils/engine/collectors/market_data/__init__.py /app/utils/engine/collectors/market_data/__init__.py
COPY utils/engine/collectors/market_data/broker.py /app/utils/engine/collectors/market_data/broker.py
COPY utils/engine/collectors/market_data/shadow.py /app/utils/engine/collectors/market_data/shadow.py
COPY model_development/models/trend_following_preny_profile_15m/legacy/deploy/phase4/*.json /app/config/
USER account
ENTRYPOINT ["python", "-m", "utils.engine.execution.paper_worker"]
