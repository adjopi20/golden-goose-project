FROM python:3.13-slim-bookworm
ARG CODE_VERSION
RUN test -n "$CODE_VERSION"
LABEL org.opencontainers.image.revision=$CODE_VERSION
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --no-cache-dir requests==2.33.1 cryptography==50.0.2 tzdata==2026.1 \
    && useradd --system --uid 1000 --create-home pilot \
    && mkdir /data && chown pilot:pilot /data
COPY utils/__init__.py /app/utils/__init__.py
COPY utils/engine/__init__.py /app/utils/engine/__init__.py
COPY utils/engine/state/base.py /app/utils/engine/state/base.py
COPY utils/engine/execution/futures_preflight.py /app/utils/engine/execution/futures_preflight.py
COPY utils/engine/state/futures.py /app/utils/engine/state/futures.py
COPY utils/engine/execution/preny_futures.py /app/utils/engine/execution/preny_futures.py
COPY utils/engine/adapters/__init__.py /app/utils/engine/adapters/__init__.py
COPY utils/engine/adapters/binance_futures_readonly.py /app/utils/engine/adapters/binance_futures_readonly.py
COPY utils/engine/adapters/binance_execution.py /app/utils/engine/adapters/binance_execution.py
COPY utils/engine/contracts.py /app/utils/engine/contracts.py
COPY model_development/models/trend_following_preny_profile_15m/legacy/pilot_worker.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/pilot_order_test.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/pilot_stop_probe.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/pilot_live_smoke.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/deploy/pilot.ethusdc.execution.json /app/config/pilot.json
USER pilot
ENTRYPOINT ["python", "-m", "model_development.models.trend_following_preny_profile_15m.legacy.pilot_worker"]
