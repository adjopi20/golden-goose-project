FROM python:3.13-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app

COPY utils/engine/deploy/requirements-paper.txt /app/requirements-paper.txt
RUN pip install --no-cache-dir -r /app/requirements-paper.txt \
    && useradd --system --uid 10001 --create-home trader \
    && mkdir /data && chown trader:trader /data

COPY paper_trading/__init__.py /app/paper_trading/
COPY utils/engine/adapters/paper_execution.py /app/utils/engine/adapters/paper_execution.py
COPY utils/__init__.py /app/utils/
COPY utils/market_session.py /app/utils/
COPY indicator/__init__.py /app/indicator/
COPY indicator/legacy_preny.py /app/indicator/
COPY indicator/value_area.py /app/indicator/
COPY utils/engine/contracts.py /app/utils/engine/contracts.py
COPY utils/engine/collectors/market_data/__init__.py /app/utils/engine/collectors/market_data/__init__.py
COPY utils/engine/collectors/market_data/aggregation.py /app/utils/engine/collectors/market_data/aggregation.py
COPY utils/engine /app/utils/engine
COPY model_development/models/trend_following_preny_profile_15m/legacy/runtime /app/model_development/models/trend_following_preny_profile_15m/legacy/runtime
COPY model_development/models/trend_following_preny_profile_15m/legacy/paper_worker.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/lighter_worker.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/calibrate_c1_native.py /app/model_development/models/trend_following_preny_profile_15m/legacy/
COPY model_development/models/trend_following_preny_profile_15m/legacy/deploy /app/model_development/models/trend_following_preny_profile_15m/legacy/deploy
COPY model_development/models/trend_following_preny_profile_15m/legacy/contracts /app/model_development/models/trend_following_preny_profile_15m/legacy/contracts

USER trader
ENTRYPOINT ["python", "-m", "model_development.models.trend_following_preny_profile_15m.legacy.paper_worker"]
CMD ["--database", "/data/binance.sqlite", "--action", "run"]
